RewriteEngine On

# ------------------------------------------------
# 0. OLD DOMAIN -> MAIN DOMAIN (dotone.biz)
# ------------------------------------------------
RewriteCond %{HTTP_HOST} ^(www\.)?dotoneforbusiness\.in$ [NC]
RewriteRule ^(.*)$ https://dotone.biz/$1 [R=301,L]

Options -Indexes
DirectorySlash Off

# ------------------------------------------------
# 1. SECURITY: never serve source, config or build files
# ------------------------------------------------
# Git history, dotfiles (.env, .gitignore, .htaccess), build tooling and docs
RedirectMatch 404 /\.(?!well-known)
RedirectMatch 404 ^/(node_modules|implementation/data)(/|$)
RedirectMatch 404 ^/(package(-lock)?\.json|tailwind\.config\.js|postcss\.config\.js|README\.md|composer\.(json|lock)|config\.php|db\.php)$
RedirectMatch 404 ^/css/tailwind\.css$
<FilesMatch "\.(md|log|sql|bak|zip|sh|lock)$">
    Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on' || %{HTTP:X-Forwarded-Proto} == 'https'"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>
ServerSignature Off

# ------------------------------------------------
# 2. ALLOW SYSTEM FILES (NO REWRITE)
# ------------------------------------------------
DirectoryIndex index.php
RewriteRule ^(sitemap\.xml|sitemap\.php|robots\.txt|favicon\.ico|google9bffe2e0ab9e0da0\.html)$ - [L]

# Header/footer partials are only included by PHP, never served directly
RewriteRule ^includes/ - [F,L]

# Server config files are never pages (also blocks the clean-URL form /db and /config)
RewriteRule ^(db|config)(\.php)?$ - [R=404,L]

# ------------------------------------------------
# 3. MOVED PAGES (new site structure) -> NEW URL (301)
# ------------------------------------------------
# Login and sign-up live on the TechDotBit app (302 so the target can change later)
RewriteRule ^(login|log-in|signin|sign-in|register|signup|sign-up)(\.html|\.php)?/?$ https://techdotbit.in/authentication/register [R=302,L]
RewriteRule ^aitools(\.html|\.php)?/?$ /ai [R=301,L]
RewriteRule ^manufacturing_solutions(\.html|\.php)?/?$ /industries [R=301,L]
RewriteRule ^demo_center(\.html|\.php)?/?$ /demo [R=301,L]
RewriteRule ^production-monitoring-software(\.html|\.php)?/?$ /production-management [R=301,L]
RewriteRule ^hrms-software-india(\.html|\.php)?/?$ /hrms [R=301,L]
RewriteRule ^sales-field-tracking(\.html|\.php)?/?$ /field-sales-tracking [R=301,L]
RewriteRule ^payroll-software-india(\.html|\.php)?/?$ /payroll [R=301,L]
RewriteRule ^manufacturing-erp-software(\.html|\.php)?/?$ /manufacturing-erp [R=301,L]
RewriteRule ^vision_ai_platform(\.html|\.php)?/?$ /vision-ai [R=301,L]
RewriteRule ^vision-ai-for-manufacturing(\.html|\.php)?/?$ /vision-ai [R=301,L]
RewriteRule ^ai-based-quality-inspection(\.html|\.php)?/?$ /vision-ai/quality-inspection [R=301,L]
RewriteRule ^manufacturing-automation-software(\.html|\.php)?/?$ /industries/manufacturing [R=301,L]
RewriteRule ^smart-factory-software(\.html|\.php)?/?$ /industries/manufacturing [R=301,L]
RewriteRule ^industry-4-0-solutions(\.html|\.php)?/?$ /solutions/digital-transformation [R=301,L]
RewriteRule ^inventory-automation-manufacturing(\.html|\.php)?/?$ /solutions/inventory-automation [R=301,L]
RewriteRule ^tally-connector-guide(\.html|\.php)?/?$ /integrations/tally [R=301,L]
RewriteRule ^what-is-erp(\.html|\.php)?/?$ /guides/what-is-erp [R=301,L]
RewriteRule ^bom-setup-guide(\.html|\.php)?/?$ /guides/bom-setup [R=301,L]
RewriteRule ^case_studies(\.html|\.php)?/?$ /case-studies [R=301,L]
RewriteRule ^dotone-webinar(\.html|\.php)?/?$ /webinar [R=301,L]
RewriteRule ^career(\.html|\.php)?/?$ /careers [R=301,L]
RewriteRule ^home(\.html|\.php)?/?$ / [R=301,L]

# ------------------------------------------------
# 4. OLD .html, DIRECT .php AND TRAILING-SLASH URLS -> CLEAN URL (301)
# ------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+index(\.html|\.php)?[\s?]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Pages only (form handlers, API endpoints and the implementation app keep their URLs)
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{REQUEST_URI} !^/(contact-submit|webinar-count|webinar-register|sitemap)\.php$
RewriteCond %{REQUEST_URI} !^/implementation/
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.php[\s?]
RewriteRule ^ /%1 [R=301,L]

# The implementation app lives in a real folder and needs its trailing slash
RewriteRule ^implementation$ /implementation/ [R=301,L]

# /ai-agents/ -> /ai-agents
RewriteCond %{REQUEST_URI} !^/implementation/
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ------------------------------------------------
# 5. INTERNAL CLEAN URL LOADER (/pricing -> pricing.php, /ai-agents/inventory -> ai-agents/inventory.php)
# ------------------------------------------------
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)$ /$1.php [L]

# ------------------------------------------------
# 6. GZIP COMPRESSION & BROWSER CACHING
# ------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
