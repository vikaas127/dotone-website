RewriteEngine On

# ------------------------------------------------
# 1. BLOCK .env FILE (SECURITY – MUST BE FIRST)
# ------------------------------------------------
<Files ".env">
    Require all denied
</Files>

# ------------------------------------------------
# 2. ALLOW SYSTEM FILES (NO REWRITE)
# ------------------------------------------------
DirectoryIndex index.php
RewriteRule ^(sitemap\.xml|sitemap\.php|robots\.txt|favicon\.ico|google9bffe2e0ab9e0da0\.html)$ - [L]

# Header/footer partials are only included by PHP, never served directly
RewriteRule ^includes/ - [F,L]

# ------------------------------------------------
# 3. OLD .html AND DIRECT .php PAGE URLS -> CLEAN URL (301, SEO)
# ------------------------------------------------
RewriteCond %{THE_REQUEST} \s/+index(\.html|\.php)?[\s?]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Pages only (form handlers and API endpoints keep their .php URL)
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{REQUEST_URI} !^/(contact-submit|webinar-count|webinar-register|sitemap)\.php$
RewriteCond %{REQUEST_URI} !^/implementation/
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.php[\s?]
RewriteRule ^ /%1 [R=301,L]

# Old duplicate homepage
RewriteRule ^home/?$ / [R=301,L]

# ------------------------------------------------
# 4. INTERNAL CLEAN URL LOADER (.php)
# ------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# ------------------------------------------------
# 5. GZIP COMPRESSION & BROWSER CACHING
# ------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
